@model IEnumerable<EventsModel>
@{
    ViewData["Title"] = "Home Page";
}

<head>
    <!-- FullCalendar Local CSS -->
    <link href="~/lib/fullcalendar/skeleton.css" rel="stylesheet" />
    <link href="~/lib/fullcalendar/themes/classic/theme.css" rel="stylesheet" />
    <link href="~/lib/fullcalendar/themes/classic/palette.css" rel="stylesheet" />
    <script src="~/lib/fullcalendar/all/global.js"></script>
    <script src="~/lib/fullcalendar/themes/classic/global.js"></script>

    <!--FullCalendar Local JS-->
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function () {
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                headerToolbar: {
                    start: 'prev next',
                    center: 'title',
                    end: 'dayGridWeek dayGridMonth'
                },
                eventSources: [{
                    url: '/Home/FindEvents',
                    contrastColor: 'black',
                    display: 'auto'
                }]
            });

            calendar.render();
        });
    </script>

</head>

<div class="calendar-wrapper">
    <div class="container">
        <div class="jumbo jumbotron" style="width:auto">
            <div class="main" id="calendar">
            </div>
        </div>
    </div>
</div>

